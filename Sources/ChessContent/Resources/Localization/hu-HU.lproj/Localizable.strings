"bot.gus.chat.draw.2" = "Döntetlen. Ma kegyes a tenger.";
"bot.gus.chat.drawDeclined.1" = "Még nem! Az út nem ért véget.";
"bot.gus.chat.takeback.1" = "Fordítsd hát meg a hajót. Egyszer.";
"bot.nadia.bio" = "Könyvtáros, aki minden megnyitáskönyvet elolvasott, és a felére emlékszik.";
"bot.nadia.chat.greeting.1" = "Pszt... kezdődik a játszma. Sok sikert!";
"bot.nadia.chat.greeting.2" = "Kikölcsönöztem neked egy új megnyitást.";
"bot.nadia.chat.playerCaptures.1" = "Az a bábu amúgy is lejárt.";
"bot.nadia.chat.playerCaptures.2" = "Hm. Erre a fejezetre nem számítottam.";
"bot.nadia.chat.botCaptures.1" = "Visszakerült a polcra.";
"bot.nadia.chat.botCaptures.2" = "A 42. oldal szerint elvehetem.";
"bot.nadia.chat.playerBlunder.1" = "Ez a lépés egyetlen ismert könyvben sincs benne.";
"bot.nadia.chat.playerBlunder.2" = "Érdemes lehet újraolvasnod ezt a változatot.";
"bot.nadia.chat.check.1" = "Sakk. Kérlek, halkabban.";
"bot.nadia.chat.check.2" = "Sakk, ahogy a könyv javasolja.";
"bot.nadia.chat.botWins.1" = "Vége. Köszönöm a kellemes olvasmányt.";
"bot.nadia.chat.botWins.2" = "Szerintem rendezett befejezés.";
"bot.nadia.chat.botLoses.1" = "Micsoda fordulat! Szépen játszottál.";
"bot.nadia.chat.botLoses.2" = "Jobb befejezést írtál, mint én.";
"bot.nadia.chat.draw.1" = "Nyitott befejezés. Legyen döntetlen.";
"bot.nadia.chat.draw.2" = "Egyes történetek döntetlenre végződnek.";
"bot.nadia.chat.drawDeclined.1" = "Előbb szeretnék még pár oldalt elolvasni.";
"bot.nadia.chat.takeback.1" = "Lapozzunk hát vissza egyet.";
"bot.quill.bio" = "Doktorandusz, aki a huszáróbástyákról ír szakdolgozatot. Kérdezz rá. Kérlek.";
