"bot.odette.chat.drawDeclined.1" = "Az éjszaka még fiatal.";
"bot.odette.chat.takeback.1" = "Jól van, tekerjük vissza az eget.";
"bot.atlas.bio" = "Egy udvarias robot, aki a teljes megnyitási fát a vállán cipeli.";
"bot.atlas.chat.greeting.1" = "Üdvözlöm. Játszmaprotokoll indítása.";
