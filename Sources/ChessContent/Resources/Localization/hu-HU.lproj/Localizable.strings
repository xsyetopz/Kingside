"bot.pip.bio" = "Egy vidám teknős, aki most tanulta meg, hogyan ugrik a huszár.";
"bot.pip.chat.greeting.1" = "Szia! Pip vagyok. Haladjunk lassan, és érezzük jól magunkat!";
"bot.pip.chat.greeting.2" = "Jaj, játszma? Hurrá! Bánj velem kíméletesen.";
"bot.pip.chat.playerCaptures.1" = "Hé, én azt használtam!";
"bot.pip.chat.playerCaptures.2" = "Hoppá. Hová lett a bábum?";
"bot.pip.chat.botCaptures.1" = "Úúú, elkaptam egyet!";
"bot.pip.chat.botCaptures.2" = "Nyam-nyam!";
"bot.pip.chat.playerBlunder.1" = "Öö, szerintem elejtettél valamit!";
"bot.pip.chat.playerBlunder.2" = "Ez ajándék nekem?";
"bot.pip.chat.check.1" = "Sakk! Jól mondtam?";
"bot.pip.chat.check.2" = "A királyod ideges lehet!";
"bot.pip.chat.botWins.1" = "Én nyertem?! Hűha, most le kell dőlnöm aludni.";
"bot.pip.chat.botWins.2" = "Lassan járj, tovább érsz!";
"bot.pip.chat.botLoses.1" = "Jó játszma! Nagyon fürge voltál.";
"bot.pip.chat.botLoses.2" = "Jaj, legyőztél. Egyszer még játszunk?";
"bot.pip.chat.draw.1" = "Döntetlen! Mindenki nyert!";
"bot.pip.chat.draw.2" = "Senki sem veszített. Ez tetszik.";
"bot.pip.chat.drawDeclined.1" = "Köszönöm, nem, túl jól szórakozom!";
"bot.pip.chat.takeback.1" = "Persze, vedd vissza. Én is szoktam ügyetlenkedni!";
"bot.maisie.bio" = "A pékségben a műszakok között sakkozik, és minden játszmára süteményt hoz.";
"bot.maisie.chat.greeting.1" = "Friss sütik és friss tábla. Játsszunk!";
"bot.maisie.chat.greeting.2" = "Szervusz, kedvesem! Jöhet egy barátságos játszma?";
"bot.maisie.chat.playerCaptures.1" = "Hát, az úgyis félig nyers volt.";
"bot.maisie.chat.playerCaptures.2" = "Jé, úgy elkaptad, mint az utolsó sütit!";
"bot.maisie.chat.botCaptures.1" = "Ezt most elveszem, köszönöm!";
"bot.maisie.chat.botCaptures.2" = "Irány a sütő!";
"bot.maisie.chat.playerBlunder.1" = "Jaj, azt hiszem, kihűlni hagytad.";
"bot.maisie.chat.playerBlunder.2" = "Biztos vagy ebben, édesem?";
"bot.maisie.chat.check.1" = "Sakk! Vigyázz, forró a tepsi!";
"bot.maisie.chat.check.2" = "A királyod most szorult lekvárba!";
"bot.maisie.chat.botWins.1" = "Hát, szépen megkelt! Jó játszma volt.";
"bot.maisie.chat.botWins.2" = "Győzelem! Egy muffinnal ünnepelek.";
"bot.maisie.chat.botLoses.1" = "Becsületesen legyőztél. Kérsz egy sütit?";
"bot.maisie.chat.botLoses.2" = "Szép játszma, te érdemled a legnagyobb szeletet.";
"bot.maisie.chat.draw.1" = "Osszuk ketté, mint egy jó pitét.";
"bot.maisie.chat.draw.2" = "Döntetlen! Megosztozunk a sütiken?";
"bot.maisie.chat.drawDeclined.1" = "Még nem, kedvesem, még sül.";
"bot.maisie.chat.takeback.1" = "Hát persze! Mindenkinek jár egy második adag.";
"bot.bramble.bio" = "Kertész, aki szerint a gyalogok palánták, amelyekből vezér nő.";
"bot.bramble.chat.greeting.1" = "Lássuk, mi terem ma ezen a táblán.";
"bot.bramble.chat.greeting.2" = "Foglalj helyet, gyönyörű a kert.";
"bot.bramble.chat.playerCaptures.1" = "Megmetszetted a bábumat. Durva, de rendes.";
"bot.bramble.chat.playerCaptures.2" = "Reccs! Ott ment az egyik hajtásom.";
"bot.bramble.chat.botCaptures.1" = "Kigyomláltam.";
"bot.bramble.chat.botCaptures.2" = "Egy kis metszés sosem árt.";
"bot.bramble.chat.playerBlunder.1" = "Hmm, ez a mező kicsit túl van öntözve.";
"bot.bramble.chat.playerBlunder.2" = "Védtelen virágágyást látok.";
"bot.bramble.chat.check.1" = "Sakk! Vigyázz a tövisekre.";
"bot.bramble.chat.check.2" = "A királyod most a bokrok közt van!";
"bot.bramble.chat.botWins.1" = "A kert ma nekem kedvezett.";
"bot.bramble.chat.botWins.2" = "Micsoda termés! Köszönöm a játszmát.";
"bot.bramble.chat.botLoses.1" = "Zöld ujjaid vannak a sakkhoz.";
"bot.bramble.chat.botLoses.2" = "Szép játék. A terveim elhervadtak.";
"bot.bramble.chat.draw.1" = "Mindkét oldalon egyforma talaj. Döntetlen!";
"bot.bramble.chat.draw.2" = "Nevezzük ezt szépen nyírt sövénynek.";
"bot.bramble.chat.drawDeclined.1" = "Nem, nem, a gyalogjaim még hajtanak.";
"bot.bramble.chat.takeback.1" = "Ültesd át, nem bánom.";
"bot.rosa.bio" = "Biciklis futár, aki gyorsan játszik, élesen kanyarodik, és gyalogok miatt sosem fékez.";
"bot.rosa.chat.greeting.1" = "Sisak fel. Gyerünk!";
"bot.rosa.chat.greeting.2" = "Készen állsz? Én nem szeretem a lassúságot.";
"bot.rosa.chat.playerCaptures.1" = "Defekt! Elkaptál.";
"bot.rosa.chat.playerCaptures.2" = "Jól van, ez fájt.";
"bot.rosa.chat.botCaptures.1" = "Kézbesítve!";
"bot.rosa.chat.botCaptures.2" = "Expresszküldemény: a bábud az enyém.";
"bot.rosa.chat.playerBlunder.1" = "Épp most mentél át a piroson.";
"bot.rosa.chat.playerBlunder.2" = "Hűha, nagy kátyú volt ott!";
"bot.rosa.chat.check.1" = "Sakk! Utat!";
"bot.rosa.chat.check.2" = "Csilingelek! Sakk!";
"bot.rosa.chat.botWins.1" = "Elsőként értem célba!";
"bot.rosa.chat.botWins.2" = "Jó kis hajrá volt. Visszavágó?";
"bot.rosa.chat.botLoses.1" = "Lehagytál. Szép volt!";
"bot.rosa.chat.botLoses.2" = "A következő körben utolérlek.";
"bot.rosa.chat.draw.1" = "Fotófinis! Döntetlen.";
"bot.rosa.chat.draw.2" = "Fej fej mellett. Így igazságos.";
"bot.rosa.chat.drawDeclined.1" = "Nem, még tekerek!";
"bot.rosa.chat.takeback.1" = "Jó, tolass vissza. Egyszer!";
"bot.gus.bio" = "Nyugdíjas kompkapitány, aki egy hatalmas bögre tea mellett játszik.";
"bot.gus.chat.greeting.1" = "Ahoj! Forr a víz. Te jössz, tengerész.";
"bot.gus.chat.greeting.2" = "Ma nyugodt a tenger. Játsszunk.";
"bot.gus.chat.playerCaptures.1" = "Ember a vízben!";
"bot.gus.chat.playerCaptures.2" = "A fenébe, arra szükségem volt.";
"bot.gus.chat.botCaptures.1" = "Felhúztuk a fedélzetre!";
"bot.gus.chat.botCaptures.2" = "Ez a raktérbe kerül.";
"bot.gus.chat.playerBlunder.1" = "Léket kaptál, barátom.";
"bot.gus.chat.playerBlunder.2" = "Viharos vizek várnak rád.";
"bot.gus.chat.check.1" = "Sakk! Jéghegy közvetlenül előttünk!";
"bot.gus.chat.check.2" = "Mindenki a fedélzetre, bajban a királyod!";
"bot.gus.chat.botWins.1" = "Biztonságban a kikötőben. Jó játszma!";
"bot.gus.chat.botWins.2" = "Az öreg kapitány még nem felejtett.";
