"bot.quill.chat.playerBlunder.2" = "Statisztikailag ez hiba volt.";
"bot.quill.chat.check.1" = "Sakk. Kérlek, hivatkozz rá a jegyzeteidben.";
"bot.quill.chat.check.2" = "Sakk! Első lábjegyzet.";
"bot.quill.chat.botWins.1" = "A tézis beigazolódott! Köszönöm a segítséget.";
"bot.quill.chat.botWins.2" = "Remek adatok. Jó játszma!";
"bot.quill.chat.botLoses.1" = "Vissza a laborba. Szépen játszottál.";
"bot.quill.chat.botLoses.2" = "A szakdolgozatomhoz új fejezet kell.";
"bot.quill.chat.draw.1" = "Nem egyértelmű eredmény. Döntetlen.";
"bot.quill.chat.draw.2" = "További kutatásra van szükség.";
"bot.quill.chat.drawDeclined.1" = "A mintám túl kicsi ahhoz, hogy most abbahagyjam.";
"bot.quill.chat.takeback.1" = "Kizárjuk ezt az adatsorból.";
"bot.priya.bio" = "Klubbajnok és gyorsfeladvány-megoldó. Szereti az éles állásokat és a hangos taktikákat.";
