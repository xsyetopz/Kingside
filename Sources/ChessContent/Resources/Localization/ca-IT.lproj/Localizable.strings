"bot.maisie.chat.playerCaptures.2" = "Ui, l'has agafada com l'última galeta!";
"bot.maisie.chat.botCaptures.1" = "Me l'enduc, gràcies!";
"bot.maisie.chat.botCaptures.2" = "Cap al forn!";
"bot.maisie.chat.playerBlunder.1" = "Ai, sembla que ho has deixat refredar.";
"bot.maisie.chat.playerBlunder.2" = "Segur que vols fer aquesta jugada, maco?";
"bot.maisie.chat.check.1" = "Escac! Compte amb la safata calenta!";
"bot.maisie.chat.check.2" = "El teu rei està en un bon embolic!";
"bot.maisie.chat.botWins.1" = "Mira com ha pujat! Bona partida.";
"bot.maisie.chat.botWins.2" = "Una victòria! Ho celebraré amb un mufin.";
"bot.maisie.chat.botLoses.1" = "M'has guanyat net i honrat. Una galeta?";
"bot.maisie.chat.botLoses.2" = "Quina partida més bonica, et mereixes el tros més gran.";
"bot.maisie.chat.draw.1" = "Partim-ho pel mig, com un bon pastís.";
"bot.maisie.chat.draw.2" = "Taules! Repartim-nos les galetes?";
"bot.maisie.chat.drawDeclined.1" = "Encara no, maco, que encara és al forn.";
"bot.maisie.chat.takeback.1" = "És clar! Tothom es mereix una segona fornada.";
"bot.bramble.bio" = "Un jardiner que creu que els peons són planters que es converteixen en dames.";
"bot.bramble.chat.greeting.1" = "Vegem què creix avui en aquest tauler.";
